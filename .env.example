# ---------------------------------------------------------------------------
# Is It Canadian? - Environment Variables
# ---------------------------------------------------------------------------

# Host ports
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# Website lookup chain (used when a URL is not provided directly):
# 1. SearXNG — existing external container on the Docker network.
# 2. Brave Search API — fallback if SearXNG returns no usable results.
# 3. Tavily Search API — final fallback if Brave also fails.
SEARXNG_BASE_URL=http://searxng:8080
# Brave key: https://api-dashboard.search.brave.com/
BRAVE_API_KEY=
# Tavily key: https://tavily.com/
TAVILY_API_KEY=

# Firecrawl service (defined in another project; connected via the external Docker network)
# The firecrawl-api service is expected to be reachable at this URL on the app-network.
FIRECRAWL_BASE_URL=http://firecrawl-api:3002
FIRECRAWL_API_KEY=

# Ollama / LLM configuration
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# Workflow tuning
FIRECRAWL_TIMEOUT=60
MIN_SCRAPE_CONTENT_LENGTH=300
MAX_SCRAPE_RETRIES=2
MAX_EVIDENCE_PAGES=5
MAX_SEARCH_CANDIDATES=10
LLM_CONTENT_BUDGET=8000
LLM_NUM_CTX=16384
LLM_NUM_PREDICT=2048
REDIRECT_TIMEOUT=10

# Cloudflare Tunnel (optional) — exposes the frontend publicly without opening
# ports. The cloudflared container is NOT built unless both are set:
#   1. TUNNEL_TOKEN — from https://one.dash.cloudflare.com/ → Networks → Tunnels
#   2. COMPOSE_PROFILES=tunnel — enables the 'tunnel' profile
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here
# COMPOSE_PROFILES=tunnel
